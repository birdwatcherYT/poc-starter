# --- データベース ---
# ローカル docker-compose / cloud-sql-proxy 経由: DB_HOST=localhost
# Cloud Run から Cloud SQL に Unix socket 接続: DB_HOST=/cloudsql/<project>:<region>:<instance>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poc
DB_USER=app_user
DB_PASSWORD=app_password

# --- ロギング ---
LOG_LEVEL=INFO
# text (ローカル色付き) | json (Cloud Logging 互換)。K_SERVICE が設定されていると強制的に json になる。
LOG_FORMAT=text

# --- GCP ---
GOOGLE_CLOUD_PROJECT=
