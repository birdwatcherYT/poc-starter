{
  "openapi": "3.1.0",
  "info": {
    "title": "PoC Starter API",
    "description": "本番運用を見据えた FastAPI + PostgreSQL の PoC スターター。",
    "version": "0.1.0"
  },
  "paths": {
    "/example/echo": {
      "post": {
        "tags": [
          "example"
        ],
        "summary": "Echo Endpoint",
        "operationId": "echo_endpoint_example_echo_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "liveness 用。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EchoRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "description": "保存したいメッセージ本文",
            "examples": [
              "hello"
            ]
          },
          "author": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Author",
            "description": "任意の送信者名",
            "examples": [
              "alice"
            ]
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "EchoRequest",
        "description": "`POST /example/echo` のリクエストボディ。"
      },
      "EchoResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "DB が払い出した主キー"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "保存されたメッセージ"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author",
            "description": "送信者名（未指定なら null）"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "DB が記録した作成時刻"
          }
        },
        "type": "object",
        "required": [
          "id",
          "message",
          "author",
          "created_at"
        ],
        "title": "EchoResponse",
        "description": "`POST /example/echo` のレスポンス。保存した行をそのまま返す。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}